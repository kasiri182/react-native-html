{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "lib": ["ES2020"],
    "types": ["react", "react-native"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "noEmitOnError": true
  },
  "include": ["src/*.ts", "src/*.tsx"]
}
