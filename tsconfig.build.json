{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "lib": [
      "ES2020"
    ],
    "types": [
      "react"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "noEmitOnError": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/*.ts",
    "src/*.tsx"
  ]
}
